
import { motion, useReducedMotion } from "framer-motion";
import { Images } from "lucide-react";
const homeImageModules = import.meta.glob(
  "../../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true, query: "?url", import: "default" }
);

const homeImages = Object.entries(homeImageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, src]) => src);

import featuredCampusImage from "../../assets/gallery/tiks-photo-015.jpeg";


const campusPhotos = [
  {
    src: featuredCampusImage,
    alt: "A moment from The Indus Karakuram School",
    label: "Celebrating Achievements",
  },
  {
    src: homeImages[1],
    alt: "Students and school activities",
    label: "School Events & Activities",
  },
  {
    src: homeImages[2],
    alt: "School community moments",
    label: "Morning Assembly",
  },
];

const CampusSection = ({ setPage }) => {
  const reduceMotion = useReducedMotion();

  return (
    <section className="relative bg-transparent px-5 py-16 sm:px-6 lg:py-24">
      <div className="mx-auto max-w-7xl">

        <div className="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <span className="text-xs font-bold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">
              Discover Our Campus
            </span>

            <h2 className="mt-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
              A Place to{" "}
              <span className="text-blue-700 dark:text-blue-200">
                Learn & Grow.
              </span>
            </h2>

            <p className="mt-5 max-w-xl text-base leading-8 text-slate-600 dark:text-slate-300">
              Explore the spaces that support
              learning, curiosity, and personal growth.
            </p>
          </div>

          {typeof setPage === "function" && (
            <button
              type="button"
              onClick={() => setPage("gallery")}
              className="inline-flex w-fit items-center gap-3 rounded-lg border border-slate-300 dark:border-[#526A87] bg-white dark:bg-[#041225] px-6 py-3.5 text-sm font-semibold text-slate-900 dark:text-white transition-colors hover:bg-slate-100 dark:hover:bg-[#091C36]"
            >
              <Images size={18} />
              Explore Gallery
            </button>
          )}
        </div>

        <div className="grid gap-4 md:h-[456px] md:grid-cols-[1.65fr_1fr]">

          <motion.figure
            initial={
              reduceMotion ? false : { opacity: 0, y: 20 }
            }
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.55 }}
            className="group relative min-w-0 h-[260px] sm:h-[340px] md:h-full overflow-hidden rounded-2xl border border-slate-200 dark:border-[#526A87]/50 bg-white dark:bg-[#041225]"
          >
            <img
              src={campusPhotos[0].src}
              alt={campusPhotos[0].alt}
              loading="lazy"
              className="absolute inset-0 h-full w-full object-contain object-center"
            />

            <div className="absolute inset-0 bg-gradient-to-t from-[#041225]/80 via-[#0B3765]/40 to-[#0B3765]/20 opacity-100 transition-opacity duration-500 ease-in-out group-hover:opacity-0" />

            <figcaption className="absolute bottom-6 left-6 text-xl font-bold text-white">
              {campusPhotos[0].label}
            </figcaption>
          </motion.figure>

          <div className="grid gap-4 sm:grid-cols-2 md:grid-cols-1 md:grid-rows-2">
            {campusPhotos.slice(1).map((photo, index) => (
              <motion.figure
                key={photo.label}
                initial={
                  reduceMotion
                    ? false
                    : { opacity: 0, y: 20 }
                }
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{
                  duration: 0.55,
                  delay: reduceMotion ? 0 : index * 0.1,
                }}
                className="group relative h-[220px] sm:h-[240px] md:h-full  overflow-hidden rounded-2xl border border-slate-200 dark:border-[#526A87]/50 bg-white dark:bg-[#041225]  "
              >
                <img
                  src={photo.src}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  className="absolute inset-0 h-full w-full object-contain object-center transition-transform duration-700 group-hover:scale-[1.02]"
                />

                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  className="block h-auto w-full object-contain transition-transform duration-700"
                />

                <div className="absolute inset-0 bg-gradient-to-t from-[#041225]/80 via-[#0B3765]/40 to-[#0B3765]/20 opacity-100 transition-opacity duration-500 ease-in-out group-hover:opacity-0" />

                <figcaption className="absolute bottom-5 left-5 text-lg font-bold text-white">
                  {photo.label}
                </figcaption>
              </motion.figure>
            ))}
          </div>
        </div>


      </div>
    </section>
  );
};

export default CampusSection;
